# このファイルは値を入れずにコミットする。
# 実際の値は .env に書く(.env はコミットされない)。

# PostgreSQL接続文字列
# 形式: postgresql+psycopg://ユーザー:パスワード@ホスト:ポート/データベース名
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD_HERE@localhost:5432/tabot

# テスト用DB(pytestが使う)
TEST_DATABASE_URL=postgresql+psycopg://postgres:PASSWORD_HERE@localhost:5432/tabot_test
